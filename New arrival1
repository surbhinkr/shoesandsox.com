<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Product Slider on Background</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
    }

    .bg-section {
      position: relative;
      background-image: url('https://cdn.shopify.com/s/files/1/0740/2582/8581/files/shoesandsox_5.png?v=1744358087');
      background-size: cover;
      background-position: center;
      padding: 60px 20px;
      color: white;
      overflow: hidden;
    }

    .bg-overlay {
      background-color: rgba(0, 0, 0, 0.4);
      padding: 40px 20px;
      border-radius: 10px;
    }

    .slider-container {
      display: flex;
      gap: 20px;
      overflow-x: auto;
      scroll-behavior: smooth;
      padding-bottom: 10px;
    }

    .slider-container::-webkit-scrollbar {
      display: none;
    }

    .product-card {
      flex: 0 0 240px;
      background: white;
      color: black;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 2px 6px rgba(0,0,0,0.2);
    }

    .product-card img {
      width: 100%;
      height: 200px;
      object-fit: cover;
    }

    .product-info {
      padding: 10px;
      text-align: center;
    }

    .product-info h4 {
      margin: 6px 0 4px;
      font-size: 16px;
    }

    .product-info .price {
      font-weight: bold;
      margin-bottom: 8px;
    }

    .product-info a {
      display: inline-block;
      background: black;
      color: white;
      padding: 8px 16px;
      font-size: 14px;
      text-decoration: none;
      border-radius: 4px;
    }
    


    @media screen and (max-width: 768px) {
      .bg-section {
        padding: 40px 10px;
      }
      .product-card {
        flex: 0 0 80%;
      }
      .slider-heading {
  text-align: center;
  font-size: 28px;
  font-weight: 800;
  letter-spacing: 2px;
  text-transform: uppercase;
  margin-bottom: 20px;
  color: White;
}

    }
  </style>
</head>
<body>

  <section class="bg-section">
    <div class="bg-overlay">
     <h2 class="slider-heading"><strong>🔥 NEW ARRIVALS</strong></h2>
      <div class="slider-container" id="productSlider">
        <div class="product-card">
          <img src="https://cdn.shopify.com/s/files/1/0740/2582/8581/files/6821f69f69388ea52d9f0a701e5dfe13.jpg?v=1744179247" />
          <div class="product-info">
            <h4>Oversized Tee</h4>
            <div class="price">₹799</div>
            <a href="https://j49i15-0d.myshopify.com/products/long-socks">Add to Bag</a>
          </div>
        </div>
        <div class="product-card">
          <img src="https://cdn.shopify.com/s/files/1/0740/2582/8581/files/69714a2b9ba91a2a39b0c35d0c789154.jpg?v=1744178854" />
          <div class="product-info">
            <h4>Wide Leg Pants</h4>
            <div class="price">₹1499</div>
            <a href="https://j49i15-0d.myshopify.com/products/ankle-socks">Add to Bag</a>
          </div>
        </div>
        <div class="product-card">
          <img src="https://cdn.shopify.com/s/files/1/0740/2582/8581/files/3c91df13d70a898e1d8901fcf8e8d426.jpg?v=1744178854" />
          <div class="product-info">
            <h4>Hoodie Light</h4>
            <div class="price">₹1199</div>
            <a href="https://j49i15-0d.myshopify.com/products/knee-length-socks">Add to Bag</a>
          </div>
        </div>
        <!-- Add more product cards here -->
      </div>
    </div>
  </section>

</body>
</html>
